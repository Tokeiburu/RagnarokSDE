<Styles:TkWindow x:Class="SDE.View.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Styles="clr-namespace:TokeiLibrary.WPF.Styles;assembly=TokeiLibrary"
        xmlns:ListView="clr-namespace:TokeiLibrary.WPF.Styles.ListView;assembly=TokeiLibrary"
        xmlns:TokeiLibrary="clr-namespace:TokeiLibrary;assembly=TokeiLibrary"
        xmlns:Application="clr-namespace:GrfToWpfBridge.Application;assembly=GrfToWpfBridge"
        xmlns:SdeConfig="clr-namespace:SDE.ApplicationConfiguration"
        xmlns:ProjectConfig="clr-namespace:SDE.Editor"
		SnapsToDevicePixels="True" UseLayoutRounding="True"
		MaxWidth="470" MinWidth="470" MinHeight="475" MaxHeight="475" Foreground="{DynamicResource TextForeground}"
        Background="{DynamicResource TabItemBackground}">
	<Grid>
		<Grid.Resources>
			<Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource ThemeCheckBoxStyle}">
				<Setter Property="Foreground" Value="{DynamicResource TextForeground}" />
				<Setter Property="Margin" Value="3" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="HorizontalAlignment" Value="Left" />
				<Setter Property="ToolTipService.ShowDuration" Value="30000" />

				<Setter Property="ContentTemplate">
					<Setter.Value>
						<DataTemplate>
							<TextBlock Text="{Binding}" x:Name="text"/>
							<DataTemplate.Triggers>
								<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=CheckBox}}" Value="True">
									<Setter TargetName="text" Property="TextDecorations" Value="Underline"/>
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</Setter.Value>
				</Setter>

				<Style.Triggers>
					<Trigger Property="IsMouseOver" Value="True">
						<Setter Property="Cursor" Value="Hand"/>
						<Setter Property="Foreground" Value="{DynamicResource MouseOverTextBrush}" />
					</Trigger>
				</Style.Triggers>
			</Style>
		</Grid.Resources>
		<Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource ResourceKey=TabControlBackground}">
            <Grid>
                <TabControl Style="{DynamicResource ResourceKey=TabControlStyled}" Focusable="True" FocusVisualStyle="{x:Null}">
                    <TabItem Header="General" Style="{DynamicResource ResourceKey=TabItemStyled}" Foreground="{DynamicResource TextForeground}">
                        <StackPanel Focusable="True" FocusVisualStyle="{x:Null}">
                            <StackPanel>
                                <Label Content="{Binding Path=Header, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" FontWeight="Bold" FontSize="16" Margin="3 10 0 5" />
                                <Rectangle Margin="5 0 5 5" Stroke="#E3E9F1" VerticalAlignment="Stretch" />
                            </StackPanel>
                            <Grid Name="_gridGeneral">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                
                                <Label Grid.Row="0" Margin="3 5 3 0" Content="Notepad++ path :" Padding="0" >
                                    <Label.ToolTip>
                                        <TextBlock>
                                        Leave empty to autodetect the path.
                                        </TextBlock>
                                    </Label.ToolTip>
                                </Label>
                                
                                <Styles:PathBrowser x:Name="_pbNotepad" BrowseMode="File" Filter="Executable Files (*.exe)|*.exe" Grid.Row="1" Grid.ColumnSpan="2" />

                                <Label Content="Compression method" Padding="0" Grid.Row="2" Margin="3" VerticalAlignment="Center" >
                                    <Label.ToolTip>
                                        <TextBlock>
                                            The output format of the GRF.
                                        </TextBlock>
                                    </Label.ToolTip>
                                </Label>
                                <Label Grid.Row="3" Content="Theme" Visibility="Visible" >
                                    <Label.ToolTip>
                                        <TextBlock>
                                        Determines Server Database Editor's UI style.
                                        </TextBlock>
                                    </Label.ToolTip>
                                </Label>
                                <Application:CompressionMethodPicker Grid.Row="2" Grid.Column="1" Name="_comboBoxCompression" VerticalAlignment="Center" Margin="3" HorizontalAlignment="Left" Width="120" />

                                <ComboBox Grid.Row="3" Grid.Column="1" Name="_comboBoxStyles" VerticalAlignment="Center" Margin="3" Visibility="Visible" Width="120" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Default" />
                                    <ComboBoxItem Content="Dark theme" />
                                </ComboBox>

								<StackPanel Grid.Row="4" Grid.ColumnSpan="2">
									<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.AlwaysReopenLatestProject), Mode=TwoWay}" Content="Always reopen the latest opened project" ToolTip="Always reopen the most recently opened project when starting the application." />
									<CheckBox Click="_cbSdeShell_Click" IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.SdeShellAssociated), Mode=TwoWay}" Content="Associate the .sde file extension with this tool" />
									<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.BackupsManagerState), Mode=TwoWay}" Content="Enable backups manager" />
									<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.EnableMultipleSetters), Mode=TwoWay}" Content="Apply modifications to all selected items" ToolTip="If checked, every field that you edit will modify all the currently selected items." />
									<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.BindItemTabs), Mode=TwoWay}" Content="Bind item tabs together" ToolTip="If checked, both the Client Items and Items tab will sync." />
									<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.AlwaysOverwriteFiles), Mode=TwoWay}" Content="Always overwrite non-modified files" ToolTip="If checked, non-modified files will be overwritten in your db folder." />
								</StackPanel>
                            </Grid>
                        </StackPanel>
                    </TabItem>
					<TabItem Header="Dialogs" Style="{DynamicResource ResourceKey=TabItemStyled}" Foreground="{DynamicResource TextForeground}">
						<StackPanel>
							<StackPanel>
								<Label Content="Dialogs" FontWeight="Bold" FontSize="16" Margin="3 10 0 5" />
								<Rectangle Margin="5 0 5 5" Stroke="#E3E9F1" VerticalAlignment="Stretch" />
							</StackPanel>
							<StackPanel>
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.UseIntegratedDialogsForFlags), Mode=TwoWay}" Content="Use integrated dialogs for flags" ToolTip="If unchecked, this will open dialogs on all the '...' buttons." />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.UseIntegratedDialogsForScripts), Mode=TwoWay}" Content="Use integrated dialogs for scripts" ToolTip="If unchecked, this will open dialogs on all the '...' buttons." />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.UseIntegratedDialogsForLevels), Mode=TwoWay}" Content="Use integrated dialogs for levels" ToolTip="If unchecked, this will open dialogs on all the '...' buttons." />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.UseIntegratedDialogsForJobs), Mode=TwoWay}" Content="Use integrated dialogs for jobs" ToolTip="If unchecked, this will open dialogs on all the '...' buttons." />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.UseIntegratedDialogsForTime), Mode=TwoWay}" Content="Use integrated dialogs for time" ToolTip="If unchecked, this will open dialogs on all the '...' buttons." />
							</StackPanel>
							<Grid Name="_gridDialogs">
								<Grid.RowDefinitions>
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>
							</Grid>
						</StackPanel>
					</TabItem>
					<TabItem Header="Autocomplete" Style="{DynamicResource ResourceKey=TabItemStyled}" Foreground="{DynamicResource TextForeground}">
						<ScrollViewer VerticalScrollBarVisibility="Auto">
							<StackPanel >
								<StackPanel>
									<Label Content="Autocomplete" FontWeight="Bold" FontSize="16" Margin="3 10 0 5" />
									<Rectangle Margin="5 0 5 5" Stroke="#E3E9F1" VerticalAlignment="Stretch" />
								</StackPanel>
								<Grid Name="_gridAutocomplete">
									<Grid.RowDefinitions>
										<RowDefinition />
										<RowDefinition />
										<RowDefinition />
										<RowDefinition />
										<RowDefinition />
										<RowDefinition />
										<RowDefinition />
										<RowDefinition />
										<RowDefinition />
										<RowDefinition />
										<RowDefinition />
										<RowDefinition />
										<RowDefinition />
									</Grid.RowDefinitions>
									<Grid.ColumnDefinitions>
										<ColumnDefinition />
									</Grid.ColumnDefinitions>
									<Grid Grid.Row="0">
										<CheckBox Content="Only complete empty fields" IsChecked="{Binding Path=(ProjectConfig:ProjectConfiguration.AutocompleteFillOnlyEmptyFields), Mode=TwoWay}" />
									</Grid>
									<Grid Grid.Row="1">
										<Grid.RowDefinitions>
											<RowDefinition Height="auto" />
											<RowDefinition Height="auto" />
											<RowDefinition Height="auto" />
											<RowDefinition Height="auto" />
											<RowDefinition Height="auto" />
										</Grid.RowDefinitions>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="auto" />
											<ColumnDefinition Width="auto" />
										</Grid.ColumnDefinitions>
										<TextBlock Text="Completion fields" Margin="3" Grid.ColumnSpan="10" FontStyle="Italic" />
										<CheckBox Grid.Column="0" Grid.Row="1" Content="Id. display name" IsChecked="{Binding Path=(ProjectConfig:ProjectConfiguration.AutocompleteIdDisplayName), Mode=TwoWay}" />
										<CheckBox Grid.Column="1" Grid.Row="1" Content="Un. display name" IsChecked="{Binding Path=(ProjectConfig:ProjectConfiguration.AutocompleteUnDisplayName), Mode=TwoWay}" />
										<CheckBox Grid.Column="0" Grid.Row="2" Content="Id. resource name" IsChecked="{Binding Path=(ProjectConfig:ProjectConfiguration.AutocompleteIdResourceName), Mode=TwoWay}" />
										<CheckBox Grid.Column="1" Grid.Row="2" Content="Un. resource name" IsChecked="{Binding Path=(ProjectConfig:ProjectConfiguration.AutocompleteUnResourceName), Mode=TwoWay}" />
										<CheckBox Grid.Column="0" Grid.Row="3" Content="Id. description" IsChecked="{Binding Path=(ProjectConfig:ProjectConfiguration.AutocompleteIdDescription), Mode=TwoWay}" />
										<CheckBox Grid.Column="1" Grid.Row="3" Content="Un. description" IsChecked="{Binding Path=(ProjectConfig:ProjectConfiguration.AutocompleteUnDescription), Mode=TwoWay}" />
										<CheckBox Grid.Column="0" Grid.Row="4" Content="Number of slots" IsChecked="{Binding Path=(ProjectConfig:ProjectConfiguration.AutocompleteNumberOfSlot), Mode=TwoWay}" />
										<CheckBox Grid.Column="1" Grid.Row="4" Content="View ID" IsChecked="{Binding Path=(ProjectConfig:ProjectConfiguration.AutocompleteViewId), Mode=TwoWay}" />
									</Grid>
									<Grid Name="_gridDescription" Grid.Row="2">
										<Grid.RowDefinitions>
											<RowDefinition Height="auto" />
											<RowDefinition Height="auto" />
											<RowDefinition Height="auto" />
											<RowDefinition Height="auto" />
											<RowDefinition Height="auto" />
											<RowDefinition Height="auto" />
											<RowDefinition Height="auto" />
											<RowDefinition Height="auto" />
											<RowDefinition Height="auto" />
											<RowDefinition Height="auto" />
											<RowDefinition Height="auto" />
										</Grid.RowDefinitions>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="auto" />
											<ColumnDefinition />
											<ColumnDefinition Width="auto" />
											<ColumnDefinition />
										</Grid.ColumnDefinitions>
										<TextBlock Text="Description" Margin="3" Grid.ColumnSpan="10" VerticalAlignment="Center" FontStyle="Italic" />
										<CheckBox Grid.Column="0" Grid.Row="1" Content="Add neutral property" Grid.ColumnSpan="5" IsChecked="{Binding Path=(ProjectConfig:ProjectConfiguration.AutocompleteNeutralProperty), Mode=TwoWay}" />
										<DockPanel Grid.ColumnSpan="4" Grid.Row="2" LastChildFill="False">
											<TextBlock Text="Property format" Margin="3" Grid.Row="2" VerticalAlignment="Center" />
											<TextBox Margin="3" Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left" Text="{Binding Path=(ProjectConfig:ProjectConfiguration.AutocompleteDescriptionFormat), Mode=TwoWay}" />
										</DockPanel>
										<Grid Name="_gridDescProp" Grid.Row="3" Grid.ColumnSpan="4">
											<Grid.ColumnDefinitions>
												<ColumnDefinition />
												<ColumnDefinition />
											</Grid.ColumnDefinitions>
										</Grid>
									</Grid>
									<Grid Grid.Row="3">
										<Grid.RowDefinitions>
											<RowDefinition Height="50" />
										</Grid.RowDefinitions>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="auto" />
											<ColumnDefinition />
										</Grid.ColumnDefinitions>
										<TextBlock Text="Unidentified&#10;description" Margin="3" Grid.Row="0" VerticalAlignment="Center" />
										<TextBox Margin="3" Grid.Row="0" Grid.Column="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" Text="{Binding Path=(ProjectConfig:ProjectConfiguration.AutocompleteUnDescriptionFormat), Mode=TwoWay}" />
									</Grid>
									<Grid Grid.Row="4">
										<Grid.RowDefinitions>
											<RowDefinition Height="50" />
										</Grid.RowDefinitions>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="auto" />
											<ColumnDefinition />
										</Grid.ColumnDefinitions>
										<TextBlock Text="Description&#10;not set" Margin="3" Grid.Row="0" VerticalAlignment="Center" />
										<TextBox Margin="3" Grid.Row="0" Grid.Column="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" Text="{Binding Path=(ProjectConfig:ProjectConfiguration.AutocompleteDescNotSet), Mode=TwoWay}" />
									</Grid>
								</Grid>
							</StackPanel>
						</ScrollViewer>
					</TabItem>
					<TabItem Header="ItemInfo" Style="{DynamicResource ResourceKey=TabItemStyled}" Foreground="{DynamicResource TextForeground}">
						<StackPanel>
							<StackPanel>
								<Label Content="ItemInfo" FontWeight="Bold" FontSize="16" Margin="3 10 0 5" />
								<Rectangle Margin="5 0 5 5" Stroke="#E3E9F1" VerticalAlignment="Stretch" />
							</StackPanel>
							<StackPanel>
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.DbWriterItemInfoUnDisplayName), Mode=TwoWay}" Content="itemInfo.lua: Write unidentifiedDisplayName" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.DbWriterItemInfoUnResource), Mode=TwoWay}" Content="itemInfo.lua: Write unidentifiedResourceName" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.DbWriterItemInfoUnDescription), Mode=TwoWay}" Content="itemInfo.lua: Write unidentifiedDescriptionName" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.DbWriterItemInfoIdDisplayName), Mode=TwoWay}" Content="itemInfo.lua: Write identifiedDisplayName" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.DbWriterItemInfoIdResource), Mode=TwoWay}" Content="itemInfo.lua: Write identifiedResourceName" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.DbWriterItemInfoIdDescription), Mode=TwoWay}" Content="itemInfo.lua: Write identifiedDescriptionName" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.DbWriterItemInfoSlotCount), Mode=TwoWay}" Content="itemInfo.lua: Write slotCount" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.DbWriterItemInfoClassNum), Mode=TwoWay}" Content="itemInfo.lua: Write ClassNum" />
								<CheckBox IsChecked="{Binding Path=(SdeConfig:SdeAppConfiguration.DbWriterItemInfoIsCostume), Mode=TwoWay}" Content="itemInfo.lua: Write costume" />
							</StackPanel>
							<Grid Name="_gridDbWriter">
								<Grid.RowDefinitions>
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
									<RowDefinition />
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition />
								</Grid.ColumnDefinitions>
							</Grid>
						</StackPanel>
					</TabItem>
					<TabItem Header="Shortcuts" Style="{DynamicResource ResourceKey=TabItemStyled}" Foreground="{DynamicResource TextForeground}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <StackPanel Focusable="True" FocusVisualStyle="{x:Null}">
                                <Label Content="Shortcuts" FontWeight="Bold" FontSize="16" Margin="3 10 0 5" />
                                <Rectangle Margin="5 0 5 5" Stroke="#E3E9F1" VerticalAlignment="Stretch" />
                                <WrapPanel>
                                    <Styles:FancyButton x:Name="_fbResetShortcuts" Click="_fbResetShortcuts_Click" HorizontalAlignment="Left" TextHeader="Reset" TextDescription="Reset all shortcuts" />
                                    <Styles:FancyButton x:Name="_fbRefreshhortcuts" Click="_fbRefreshhortcuts_Click" HorizontalAlignment="Left" TextHeader="Update" TextDescription="Look for new loaded shortcuts" />
                                </WrapPanel>
                                <Rectangle Margin="5" Stroke="#E3E9F1" VerticalAlignment="Stretch" />
                                <DockPanel>
                                    <Label Content="Search" />
                                    <TextBox Name="_tbSearch" Margin="2" TextChanged="_tbSearch_TextChanged" VerticalContentAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="True" FocusVisualStyle="{x:Null}">
                                <Grid Name="_gridShortcuts" Focusable="True" FocusVisualStyle="{x:Null}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
        <Grid TokeiLibrary:WpfProperties.IsDraggable="True" Grid.Row="2" Height="40" Background="{DynamicResource UIDialogBackground}">
            <DockPanel HorizontalAlignment="Right" Margin="0 0 3 0">
                <Button Content="Ok" Height="25" Margin="3" Width="100" Click="_buttonClose" />
            </DockPanel>
        </Grid>
    </Grid>
</Styles:TkWindow>
